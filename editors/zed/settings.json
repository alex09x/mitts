//
// Merge into ~/.config/zed/settings.json (`zed: open settings`) or a project's
// .zed/settings.json. rust-analyzer's on-save check and its runnables run through Mitts;
// rust-analyzer still loads the project with `cargo metadata`.
{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "check": {
          "overrideCommand": ["mitts", "check", "--workspace", "--all-targets", "--message-format=json"]
        },
        "runnables": {
          "command": "mitts"
        }
      }
    }
  }
}
